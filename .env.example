# ──────────────────────────────────────────────────────────────
# Vendedor Mestre - Recrutamento Automatico
# Copie este arquivo para .env e preencha. NUNCA comite o .env real.
# ──────────────────────────────────────────────────────────────

# Servidor
NODE_ENV=development   # development | production. Em prod o Dockerfile/EasyPanel ja injeta "production"
PORT=3000
APP_BASE_URL=https://entrevista.vendedormestre.com.br   # base dos links em e-mails (ex.: link do relatorio)
# Caminho do banco SQLite. Em DEV use o relativo abaixo (a pasta ./data e criada
# automaticamente no boot). Em PRODUCAO (EasyPanel), monte um volume persistente em
# /data e o app aponta para /data/app.db — o Dockerfile ja injeta esse valor e declara
# VOLUME ["/data"], entao o banco SOBREVIVE a redeploys. Nao e preciso setar esta var
# em producao se usar a imagem do Dockerfile.
DATABASE_PATH=./data/app.db
# (Banco de Curriculos) Pasta dos PDFs de curriculo do banco de talentos, separada da
# pasta de curriculos do funil de vagas. Vazio = default: <pasta do banco>/curriculos_talentos
# (ex.: ./data/curriculos_talentos em dev, /data/curriculos_talentos em producao).
CAMINHO_CURRICULOS_TALENTOS=
SESSION_SECRET=troque-isto
# (Promocao de Vagas) Segredo que assina os links de descadastro dos e-mails de
# divulgacao. NAO tem fallback para SESSION_SECRET e NAO tem default: sem ele, gerar
# link de descadastro FALHA na hora (proposital — e-mail enviado e imutavel, entao a
# falta de configuracao tem que aparecer ANTES do disparo, nao depois).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ── ESTE MESMO SEGREDO ASSINA TAMBEM O LINK DE DESCADASTRO POR WHATSAPP ──
# (lib/descadastroWhatsapp.js, pagina publica /descadastro/:token). NAO ha variavel
# separada de proposito: esta ja existe, ja esta definida em producao e ja traz a janela
# de rotacao abaixo, que e a parte dificil de acertar. Um env novo abriria uma janela em
# que o codigo esta no ar e o segredo ainda nao — e nela TODO link de descadastro emitido
# seria invalido.
# Os dois esquemas nao se misturam: o HMAC do WhatsApp e calculado sobre uma string
# prefixada ('optout-wa:v1:<telefone canonico>'), entao um token de e-mail nunca valida
# como token de telefone, nem o contrario. Rotacionar esta chave rotaciona os dois canais
# ao mesmo tempo, com a mesma janela de dois segredos.
DESCADASTRO_SECRET=
# Segredo ANTERIOR (opcional; vazio = nunca houve rotacao, que e o caso normal).
# A verificacao aceita o token do segredo atual OU deste, entao trocar a chave NAO
# quebra os links de descadastro ja enviados.
#
# COMO ROTACIONAR, sem invalidar nada:
#   1. copie o valor de DESCADASTRO_SECRET para DESCADASTRO_SECRET_ANTERIOR;
#   2. gere um valor novo e ponha em DESCADASTRO_SECRET;
#   3. reinicie a aplicacao.
# Links novos passam a usar a chave nova; os antigos seguem validos por tempo
# indeterminado. So esvazie _ANTERIOR quando aceitar quebrar os links emitidos com ela —
# e nao ha pressa nenhuma para fazer isso.
DESCADASTRO_SECRET_ANTERIOR=
AGENT_NAME=Vera
RECRUITER_EMAIL=recrutador@exemplo.com
# WhatsApp do recrutador (modo Simples): destino do botao "Avisar recrutador".
# Formato internacional com +; o app remove +/espacos ao montar o link wa.me.
# Se vazio, a pagina de confirmacao ainda renderiza, mas com o botao desabilitado.
RECRUITER_WHATSAPP=+553121811220

# Painel do recrutador: credenciais fixas da tela de login do /admin.
# Acesse /admin/login e entre com estes usuario e senha; o app grava um cookie
# assinado (15 dias). Sem usuario OU sem senha = painel BLOQUEADO. NUNCA comite os
# valores reais.
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# Rastreio (so pageview). Injetados no layout do candidato APENAS quando definidos
# (vazio = nada injetado). Nunca vao para o painel /admin. NAO comite valores reais.
GTM_ID=          # ex.: GTM-XXXXXXX (Google Tag Manager)
META_PIXEL_ID=   # ex.: 1234567890 (Meta/Facebook Pixel)

# Entrevista
INTERVIEW_MOCK=true            # true = sem chamadas externas (custo zero). false exige chaves de API
MAX_DURACAO_MIN=40             # duracao de referencia da entrevista (timer)
MAX_PERGUNTAS=24               # (modo real) teto de perguntas antes de encerrar
HISTORICO_TURNS_RECENTES=6     # (modo real) qtos turns completos vao ao LLM; os antigos viram resumo curto
PROVIDER_TIMEOUT_MS=30000      # (modo real) timeout por chamada externa (STT/LLM/TTS)

# LLM (so usado quando INTERVIEW_MOCK=false). Default: OpenRouter (gateway unificado,
# API compativel com a da OpenAI — uma chave, varios modelos).
LLM_PROVIDER=openrouter                            # openrouter | anthropic
OPENROUTER_API_KEY=                                # https://openrouter.ai (chave sk-or-v1-...)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # endpoint compativel OpenAI (/chat/completions)
# Dois modelos por tipo de tarefa (o adaptador escolhe pelo opcoes.tarefa; default=complexo):
LLM_MODEL_COMPLEXO=deepseek/deepseek-v4-flash      # perguntas da entrevista e relatorio
LLM_MODEL_SIMPLES=deepseek/deepseek-chat-v3.1      # tarefas leves (classificacao/validacao curta)
# Obs.: o adaptador desabilita o "reasoning" (reasoning.enabled=false) para respostas
# diretas, mais rapidas e baratas (nao gastamos tokens de raciocinio).
ANTHROPIC_API_KEY=                                 # alternativa (chave Anthropic direta)

# STT - transcricao de audio (so usado quando INTERVIEW_MOCK=false). Default: Groq Whisper
STT_PROVIDER=groq                           # groq | openai
GROQ_API_KEY=                               # https://console.groq.com
GROQ_STT_MODEL=whisper-large-v3             # modelo Whisper no Groq
OPENAI_API_KEY=                             # alternativa (Whisper da OpenAI)

# TTS - voz do agente Vera (so usado quando INTERVIEW_MOCK=false). Default: Google Cloud TTS (pt-BR)
TTS_PROVIDER=google                         # google | openai
GOOGLE_TTS_VOICE=pt-BR-Wavenet-A            # baixo custo; upgrade: pt-BR-Chirp3-HD-* (mais caro/natural)
GOOGLE_TTS_LANGUAGE=pt-BR
# Credencial do Google em UMA das duas formas (o adaptador tenta nesta ordem):
GOOGLE_TTS_CREDENTIALS_JSON=                # (1) JSON inteiro da service account numa unica env (ideal p/ EasyPanel)
GOOGLE_APPLICATION_CREDENTIALS=             # (2) caminho do arquivo .json da service account (deixe fora do repo)

# Google Drive (Fase 5) - destino das gravacoes de video. Reusa a credencial do Google
# acima (mesma Service Account). RECOMENDADO em producao: pre-criar a pasta numa conta
# humana (ou Shared Drive), compartilha-la como Editor com o e-mail da Service Account e
# colar o ID dela em GOOGLE_DRIVE_FOLDER_ID (a SA nao tem cota de storage propria).
GOOGLE_DRIVE_FOLDER_ID=                      # id da pasta-destino (vazio = procura/cria pela pasta abaixo)
GOOGLE_DRIVE_FOLDER_NAME=Entrevistas VM      # nome da pasta criada/procurada quando FOLDER_ID vazio

# E-mail (Fase 4) - envio do relatorio ao recrutador. Destinatario = RECRUITER_EMAIL (acima).
RESEND_API_KEY=                                      # https://resend.com (dominio verificado)
RESEND_FROM_EMAIL=jean@vendedormestre.com.br         # remetente de TODOS os e-mails (precisa ser do dominio verificado)

# ──────────────────────────────────────────────────────────────
# E-mail de CAMPANHA (Promocao de Vagas) - hoje no Emailit, via API REST.
#
# ATENCAO — O TRANSPORTE DEFAULT MUDOU (2026-08-10). O Railway BLOQUEIA egress SMTP
# neste servico: 587, 465 e 2525 dao timeout de dentro do container, contra Emailit,
# Gmail e SendGrid igualmente (nao e o provedor, e a plataforma), enquanto
# api.emailit.com:443 responde normal. Por isso o default e agora a API REST.
#
# O SMTP continua implementado e volta com EMAIL_CAMPANHA_TRANSPORTE=smtp, no dia em
# que o Railway liberar a porta. MIGRAR PARA AMAZON SES QUANDO APROVADO: o SES fala
# SMTP, entao seria trocar as SMTP_CAMPANHA_* e voltar o transporte para smtp —
# mas so depois de confirmar que o egress foi liberado, senao repete este mesmo bug.
#
# Este bloco e SEPARADO do RESEND_* acima de proposito: campanha usa remetente e
# reputacao proprios, para uma denuncia de spam em divulgacao nunca atingir a entrega
# dos e-mails transacionais do funil (relatorio, lembrete, recusa, follow-up).
#
# PASSO MANUAL, fora do codigo e fora deste incremento: verificar o dominio de campanha
# no provedor (registros SPF/DKIM/DMARC do subdominio). Enquanto isso nao estiver feito,
# o envio real vai falhar na autenticacao do provedor — o adaptador esta pronto, o
# dominio nao.
# ──────────────────────────────────────────────────────────────
# Transporte ativo: api (default, HTTPS) | smtp (legado, bloqueado no Railway hoje).
# Valor desconhecido NAO cai em default silencioso — o primeiro envio lanca.
EMAIL_CAMPANHA_TRANSPORTE=api
# Chave da API REST do Emailit (painel do provedor, formato em_...). E OUTRA credencial,
# nao e o usuario/senha de SMTP abaixo: vai no header Authorization: Bearer.
EMAILIT_API_KEY=
# Endpoint sobrescrevivel (sandbox/self-host). Vazio = https://api.emailit.com/v2/emails
EMAILIT_API_URL=

# ── Abaixo: transporte SMTP legado (so usado com EMAIL_CAMPANHA_TRANSPORTE=smtp) ──
SMTP_CAMPANHA_HOST=smtp.emailit.com          # SES: email-smtp.<regiao>.amazonaws.com
SMTP_CAMPANHA_PORTA=587                      # 587 = STARTTLS (recomendado) | 465 = TLS implicito
SMTP_CAMPANHA_SEGURO=false                   # false p/ 587 (STARTTLS). SO use true na porta 465
SMTP_CAMPANHA_USUARIO=                       # credencial SMTP do provedor
SMTP_CAMPANHA_SENHA=                         # credencial SMTP do provedor (NUNCA comitar a real)
# Remetente das campanhas: subdominio DEDICADO, diferente do transacional. O valor abaixo
# e um placeholder — confirme o dominio de fato verificado no provedor antes do 1o disparo.
SMTP_CAMPANHA_FROM_EMAIL=vagas@vagas.vendedormestre.com.br

# ──────────────────────────────────────────────────────────────
# Sequencia de WhatsApp (WA1/WA2) — instancia Baileys propria
# ──────────────────────────────────────────────────────────────

# Habilita o subsistema Baileys. Default false: com ela desligada, todo o resto do sistema
# funciona normalmente e nenhum socket de WhatsApp e aberto — conectar() recusa na entrada.
# Este e o primeiro dos dois kill-switches; o segundo (whatsapp_sequencia_ativa) fica no
# painel /admin/config e controla o DISPARO.
#
# ⚠️ Ela NAO faz o boot conectar sozinho. Quem decide isso e
# WHATSAPP_BAILEYS_CONECTAR_NO_BOOT, logo abaixo. Ate 2026-08-14 este comentario dizia
# "liga a CONEXAO no boot", e a descricao estava errada: nao havia nenhuma chamada a
# conectar() no boot: o subsistema existia e ninguem o acionava.
WHATSAPP_BAILEYS_ATIVO=false

# Controla se o boot chama conectar() automaticamente. Default ausente = false.
#
# Separado de WHATSAPP_BAILEYS_ATIVO de proposito: esta liga o Baileys existir/estar pronto;
# aquela liga a tentativa de conexao real acontecer NESTE boot.
#
# Mantenha false ate estar pronto para escanear o QR imediatamente apos o proximo
# deploy/restart. O QR do WhatsApp vale ~20 segundos e se renova sozinho, mas um processo
# em pareamento sem ninguem do outro lado fica tentando a esmo — e, pior, o momento de
# escanear e presencial: depende de alguem com o celular do numero em maos.
WHATSAPP_BAILEYS_CONECTAR_NO_BOOT=false

# Modo simulado. Default TRUE: o job registra no log o que ENVIARIA e marca a linha como
# enviada, sem tocar o socket. Passe a false so depois de parear o numero.
WHATSAPP_SEQUENCIA_MOCK=true

# ⚠️ CHAVE DE CIFRAGEM DA SESSAO — LEIA ANTES DE DEFINIR.
#
# A sessao do WhatsApp (tabela baileys_auth) e gravada CIFRADA com AES-256-GCM usando esta
# chave. Ela protege credenciais que permitem ENVIAR MENSAGEM COMO O JEAN — um dump do
# banco sem ela nao entrega nada.
#
# PERDER OU TROCAR ESTA CHAVE TORNA A SESSAO IRRECUPERAVEL. Nao ha como decifrar o que ja
# esta gravado, e a unica saida e apagar baileys_auth e PAREAR O NUMERO DE NOVO, lendo o QR
# no celular. Nao ha rotacao com janela de dois segredos como em DESCADASTRO_SECRET: aqui
# o dado cifrado e estado vivo, nao token emitido.
#
# Gere com: openssl rand -hex 32   (32 bytes = 64 caracteres hex)
WHATSAPP_SECRETS_KEY=

# Intervalo minimo entre dois envios reais, em ms. Default 3000 (3 s). Volume aqui e baixo,
# mas mensagem de WhatsApp em rajada e o padrao que derruba numero.
WHATSAPP_INTERVALO_MS=3000

# Teto de tentativas de envio de uma etapa antes de marcar 'falha'. Default 3.
# NAO ha WHATSAPP_SEQUENCIA_ATIVA aqui: o interruptor de DISPARO e config de BANCO
# (chave whatsapp_sequencia_ativa, painel /admin/config), igual a promocao_ativa.
WHATSAPP_MAX_TENTATIVAS=3

# ──────────────────────────────────────────────────────────────
# Campanha em massa por WhatsApp — envio via CENTRAL WHATS
# ──────────────────────────────────────────────────────────────
#
# FRENTE SEPARADA do Baileys (WHATSAPP_BAILEYS_ATIVO acima). ⚠️ Um numero registrado num
# WABA NAO pode ser usado via Baileys — com o mesmo numero, as duas frentes sao mutuamente
# exclusivas.
#
# ── MUDANCA DE ARQUITETURA ──
# O Recrutador NAO fala mais com a Graph API da Meta. Ele continua dono de tudo que decide
# QUEM recebe — segmentacao, materializacao da fila, throttle, retry, kill-switch — e delega
# o TRANSPORTE ao Central Whats, um projeto separado que ja tem App aprovado na Meta e guarda
# o token da Meta do lado dele.
#
# O que se perde nesta etapa, por decisao consciente: status de entrega automatico e opt-out
# automatico. Nao ha webhook chegando aqui. Se um candidato responder "PARAR", isso aparece
# no Live Chat do Central Whats e alguem registra o opt-out A MAO.

# Modo simulado. Default TRUE, e a AUSENCIA da variavel conta como true: cada mensagem real
# custa dinheiro e conta para a qualidade do numero, entao "pode enviar" tem que ser dito
# explicitamente. Passe a false so depois de validar o fluxo inteiro em mock.
#
# O nome menciona META e o transporte agora e o Central Whats — isso e de proposito. A
# variavel sempre foi sobre a INTENCAO de simular o disparo, nao sobre por onde ele sai, e
# renomear um kill-switch em producao troca um risco pequeno (nome datado) por um grande
# (janela em que a variavel antiga nao vale mais e a nova ainda nao foi criada).
META_CAMPANHA_MOCK=true

# ── Central Whats ──
# Base da API. Sem barra no fim.
CENTRALWHATS_BASE_URL=https://centralwhats-eta.vercel.app

# Id da instancia (o numero/conexao configurado la). Fixo por ambiente.
CENTRALWHATS_INSTANCE_ID=

# API key de servico, no header Authorization: Bearer. E SEGREDO — nunca versionar.
CENTRALWHATS_API_KEY=

# ── LEGADO: candidatas a remocao ──
#
# ⚠️ NENHUMA das tres abaixo participa mais do caminho de envio. Ficam aqui porque REMOVER
# variavel de ambiente e decisao separada desta etapa: enquanto o webhook_meta.js seguir no
# repositorio (dormente, sem rota alcancavel) e enquanto ninguem tiver confirmado que nao ha
# volta para o envio direto, apagar so troca uma configuracao inerte por um resgate dificil.
# Removar do Railway e daqui quando a decisao for tomada.

# LEGADO. Token de acesso permanente (System User). Quem fala com a Meta hoje e o Central
# Whats, com o token DELE.
META_WHATSAPP_TOKEN=

# LEGADO no envio. Id do numero no WABA — hoje quem sabe disso e o Central Whats, pela
# CENTRALWHATS_INSTANCE_ID.
META_PHONE_NUMBER_ID=

# Id da WhatsApp Business Account. Sempre foi documental; segue util para abrir suporte.
# Exemplo do ambiente atual: 1873148160307516
META_WABA_ID=

# LEGADO. Segredo do app, usado so pelo webhook dormente (routes/webhook_meta.js).
META_APP_SECRET=

# LEGADO. Token do handshake do webhook dormente.
META_WEBHOOK_VERIFY_TOKEN=
